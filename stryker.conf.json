{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "mutate": [
    "src/**/*.js",
    "!src/**/*.test.js"
  ],
  "jest": {
    "projectType": "custom",
    "config": {
      "testEnvironment": "node"
    }
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/html/index.html"
  },
  "coverageAnalysis": "perTest"
}
